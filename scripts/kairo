#!/usr/bin/env bash
# Kairo — global dev launcher (`kairo` command)
# Default: full fresh restart — stop Metro/Expo Go, clear bundler caches,
# sync deps if lockfile changed, start Metro with --clear, relaunch simulator.
set -euo pipefail

APP_ROOT="/Users/astrofy/Desktop/Kairo"
RUNTIME_DIR="${APP_ROOT}/.runtime"
PID_DIR="${RUNTIME_DIR}/pids"
LOG_DIR="${RUNTIME_DIR}/logs"
STATE_FILE="${RUNTIME_DIR}/state.json"
LOCK_FILE="${RUNTIME_DIR}/kairo.lock"
PID_FILE="${PID_DIR}/metro.pid"
METRO_LOG="${LOG_DIR}/metro.log"
DEFAULT_PORT="${KAIRO_METRO_PORT:-8081}"
BUNDLE_ID="com.maxiguillermo.kairo"
EXPO_GO_BUNDLE="host.exp.Exponent"

color() { printf '\033[%sm' "$1"; }
reset() { printf '\033[0m'; }
info()  { echo "$(color '0;36')▸$(reset) $*"; }
ok()    { echo "$(color '0;32')✓$(reset) $*"; }
warn()  { echo "$(color '0;33')!$(reset) $*"; }
err()   { echo "$(color '0;31')✗$(reset) $*" >&2; }

acquire_lock() {
  ensure_runtime_dirs
  if [[ -f "$LOCK_FILE" ]]; then
    local lock_pid
    lock_pid="$(tr -d '[:space:]' < "$LOCK_FILE" 2>/dev/null || true)"
    if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
      err "Another kairo launcher is running (PID ${lock_pid}). Stop it first or remove stale lock: ${LOCK_FILE}"
      exit 1
    fi
    rm -f "$LOCK_FILE"
  fi
  echo "$$" > "$LOCK_FILE"
}

release_lock() {
  rm -f "$LOCK_FILE" 2>/dev/null || true
}

trap release_lock EXIT

check_disk_space() {
  local avail_kb
  avail_kb="$(df -k / | awk 'NR==2 {print $4}')"
  if [[ -n "$avail_kb" && "$avail_kb" -lt 1048576 ]]; then
    warn "Low disk space (< 1 GiB free). Builds and simulator may fail."
    warn "Largest dev caches: DerivedData, CoreSimulator, ~/.npm, ~/.expo"
  fi
}

ensure_runtime_dirs() {
  mkdir -p "$PID_DIR" "$LOG_DIR"
}

write_state() {
  local status="$1" mode="$2" pid="${3:-}" health="${4:-unknown}" sim="${5:-}"
  ensure_runtime_dirs
  printf '{\n  "status": "%s",\n  "mode": "%s",\n  "pid": "%s",\n  "health": "%s",\n  "simulator": "%s",\n  "port": %s,\n  "updatedAt": "%s",\n  "appRoot": "%s"\n}\n' \
    "$status" "$mode" "$pid" "$health" "$sim" "$DEFAULT_PORT" "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$APP_ROOT" \
    > "$STATE_FILE"
}

pid_alive() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

process_cmdline() {
  local pid="$1"
  ps -p "$pid" -o command= 2>/dev/null || true
}

is_kairo_metro_process() {
  local pid="$1"
  local cmd
  cmd="$(process_cmdline "$pid")"
  [[ "$cmd" == *"Desktop/Kairo"* ]] && [[ "$cmd" == *"expo"* || "$cmd" == *"expo-start.mjs"* || "$cmd" == *"metro"* || "$cmd" == *"npm run start"* ]]
}

is_kairo_worker_process() {
  local pid="$1"
  local cmd
  cmd="$(process_cmdline "$pid")"
  [[ "$cmd" == *"Desktop/Kairo/node_modules"* ]]
}

find_metro_pid() {
  local pid=""
  if [[ -f "$PID_FILE" ]]; then
    pid="$(tr -d '[:space:]' < "$PID_FILE" 2>/dev/null || true)"
    if pid_alive "$pid" && is_kairo_metro_process "$pid"; then
      echo "$pid"
      return 0
    fi
  fi

  local match
  while IFS= read -r match; do
    if [[ -n "$match" ]] && pid_alive "$match" && is_kairo_metro_process "$match"; then
      echo "$match" > "$PID_FILE"
      echo "$match"
      return 0
    fi
  done < <(pgrep -f "${APP_ROOT}.*(expo-start\\.mjs|expo/bin/cli|npm run start)" 2>/dev/null || true)

  local listener
  while IFS= read -r listener; do
    if [[ -n "$listener" ]] && pid_alive "$listener" && is_kairo_metro_process "$listener"; then
      echo "$listener" > "$PID_FILE"
      echo "$listener"
      return 0
    fi
  done < <(lsof -tiTCP:"${DEFAULT_PORT}" -sTCP:LISTEN 2>/dev/null || true)

  return 1
}

metro_http_ok() {
  curl -fsS --max-time 2 "http://127.0.0.1:${DEFAULT_PORT}/status" >/dev/null 2>&1
}

resolve_simulator_udid() {
  local udid=""
  udid="$(defaults read com.apple.iphonesimulator CurrentDeviceUDID 2>/dev/null || true)"
  if [[ -n "$udid" ]]; then
    echo "$udid"
    return 0
  fi
  # Fallback: first available iPhone simulator
  udid="$(xcrun simctl list devices available -j 2>/dev/null \
    | /usr/bin/python3 -c "
import json, sys
data = json.load(sys.stdin)
for runtime, devices in data.get('devices', {}).items():
    if 'iOS' not in runtime:
        continue
    for d in devices:
        if d.get('isAvailable') and 'iPhone' in d.get('name', ''):
            print(d['udid'])
            raise SystemExit(0)
" 2>/dev/null || true)"
  [[ -n "$udid" ]] && echo "$udid"
}

simulator_name() {
  local udid="$1"
  xcrun simctl list devices available 2>/dev/null | awk -v id="$udid" '$0 ~ id { sub(/^[[:space:]]+/, ""); print; exit }'
}

simulator_booted() {
  local udid="$1"
  xcrun simctl list devices booted 2>/dev/null | grep -q "$udid"
}

boot_simulator() {
  local udid="$1"
  [[ -n "$udid" ]] || return 1
  local name
  name="$(simulator_name "$udid" | sed 's/ (.*//')"
  if simulator_booted "$udid"; then
    open -a Simulator >/dev/null 2>&1 || true
    return 0
  fi
  info "Booting iOS Simulator (${name})..."
  xcrun simctl boot "$udid" 2>/dev/null || true
  open -a Simulator >/dev/null 2>&1 || true
  xcrun simctl bootstatus "$udid" -b 2>/dev/null || true
  local i=0
  while (( i < 60 )); do
    if simulator_booted "$udid"; then
      return 0
    fi
    sleep 0.25
    i=$((i + 1))
  done
  return 1
}

resolve_lan_ipv4() {
  ipconfig getifaddr en0 2>/dev/null \
    || ipconfig getifaddr en1 2>/dev/null \
    || ipconfig getifaddr en2 2>/dev/null \
    || true
}

open_app_on_simulator() {
  local udid="$1"
  local port="${DEFAULT_PORT}"
  local host="127.0.0.1"
  local lan=""
  lan="$(resolve_lan_ipv4 || true)"
  if [[ -n "$lan" ]]; then
    host="$lan"
  fi
  local url="exp://${host}:${port}"
  local attempt=0

  # Launch Expo Go first so deep links have a handler (avoids simctl openurl timeouts).
  xcrun simctl launch "$udid" "$EXPO_GO_BUNDLE" >/dev/null 2>&1 || true
  sleep 2

  while (( attempt < 6 )); do
    if xcrun simctl openurl "$udid" "$url" 2>/dev/null; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 1.25
  done
  return 1
}

reload_expo_on_simulator() {
  local udid="$1"
  [[ -n "$udid" ]] || return 0
  # Shake-menu reload via AppleScript is flaky; deep-link again after Metro is warm.
  local port="${DEFAULT_PORT}"
  local host="127.0.0.1"
  local lan=""
  lan="$(resolve_lan_ipv4 || true)"
  if [[ -n "$lan" ]]; then
    host="$lan"
  fi
  local url="exp://${host}:${port}"
  xcrun simctl openurl "$udid" "$url" 2>/dev/null || true
}

ensure_project_ready() {
  if [[ ! -d "$APP_ROOT" ]]; then
    err "Kairo not found at: $APP_ROOT"
    exit 1
  fi
  if [[ ! -d "${APP_ROOT}/node_modules" ]]; then
    info "Installing dependencies (first run)..."
    (cd "$APP_ROOT" && npm install --no-audit --no-fund) >> "$METRO_LOG" 2>&1
    return
  fi
  # Keep installs current when package-lock.json changes (no full reinstall every launch).
  if [[ -f "${APP_ROOT}/package-lock.json" ]] \
    && [[ "${APP_ROOT}/package-lock.json" -nt "${APP_ROOT}/node_modules" ]]; then
    info "package-lock.json changed — syncing dependencies..."
    (cd "$APP_ROOT" && npm install --no-audit --no-fund) >> "$METRO_LOG" 2>&1
  fi
}

clear_dev_caches() {
  info "Clearing Metro / Expo dev caches..."
  rm -rf "${APP_ROOT}/.expo/web-cache" 2>/dev/null || true
  rm -rf "${APP_ROOT}/.metro-cache" 2>/dev/null || true
  rm -rf "${APP_ROOT}/node_modules/.cache/metro" 2>/dev/null || true
  rm -rf "${APP_ROOT}/node_modules/.cache/babel-loader" 2>/dev/null || true
  rm -rf "${APP_ROOT}/node_modules/.cache/@expo" 2>/dev/null || true
  rm -f "${APP_ROOT}/.metro/devices.json" 2>/dev/null || true
  local tmp="${TMPDIR:-/tmp}"
  rm -rf "${tmp}"/metro-* 2>/dev/null || true
  rm -rf "${tmp}"/haste-map-* 2>/dev/null || true
  rm -rf "${tmp}"/react-* 2>/dev/null || true
  if command -v watchman >/dev/null 2>&1; then
    (watchman watch-del-all >/dev/null 2>&1) || true
  fi
}

rotate_metro_log() {
  ensure_runtime_dirs
  if [[ -f "$METRO_LOG" ]]; then
    mv -f "$METRO_LOG" "${METRO_LOG}.prev" 2>/dev/null || true
  fi
  : > "$METRO_LOG"
}

terminate_expo_on_simulator() {
  local udid="$1"
  [[ -n "$udid" ]] || return 0
  xcrun simctl terminate "$udid" "$EXPO_GO_BUNDLE" 2>/dev/null || true
}

kill_pid_tree() {
  local pid="$1"
  [[ -n "$pid" ]] || return 0
  if ! pid_alive "$pid"; then
    return 0
  fi
  local child
  while IFS= read -r child; do
    [[ -n "$child" ]] && kill_pid_tree "$child"
  done < <(pgrep -P "$pid" 2>/dev/null || true)
  kill "$pid" 2>/dev/null || true
}

cmd_stop() {
  ensure_runtime_dirs
  local stopped=0

  if pid="$(find_metro_pid 2>/dev/null || true)" && [[ -n "$pid" ]]; then
    info "Stopping Metro (PID ${pid})..."
    kill_pid_tree "$pid"
    local i=0
    while pid_alive "$pid" && (( i < 16 )); do
      sleep 0.15
      i=$((i + 1))
    done
    if pid_alive "$pid"; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    stopped=1
  fi

  # Sweep any orphaned Kairo bundler workers still holding the port.
  local match
  while IFS= read -r match; do
    if [[ -n "$match" ]] && is_kairo_metro_process "$match"; then
      kill_pid_tree "$match"
      stopped=1
    fi
  done < <(pgrep -f "${APP_ROOT}.*(expo-start\\.mjs|expo/bin/cli|npm run start)" 2>/dev/null || true)

  while IFS= read -r match; do
    if [[ -n "$match" ]] && is_kairo_worker_process "$match"; then
      kill "$match" 2>/dev/null || true
      stopped=1
    fi
  done < <(pgrep -f "${APP_ROOT}/node_modules/(jest-worker|metro)" 2>/dev/null || true)

  local port_pid
  for port_pid in $(lsof -ti:"${DEFAULT_PORT}" 2>/dev/null || true); do
    if is_kairo_metro_process "$port_pid" || is_kairo_worker_process "$port_pid"; then
      kill_pid_tree "$port_pid" 2>/dev/null || true
      stopped=1
    fi
  done

  rm -f "$PID_FILE"
  write_state "stopped" "ios" "" "stopped" ""

  if (( stopped )); then
    ok "Kairo dev server stopped"
  else
    ok "No running Kairo dev server"
  fi
}

wait_for_metro() {
  local attempts="${1:-80}"
  local i=0
  while (( i < attempts )); do
    if metro_http_ok; then
      # Require two consecutive OK checks so we do not race a dying bundler.
      sleep 0.35
      if metro_http_ok; then
        return 0
      fi
    fi
    sleep 0.2
    i=$((i + 1))
  done
  return 1
}

launch_metro_background() {
  local fresh="${1:-false}"
  ensure_runtime_dirs
  : >> "$METRO_LOG"

  local clear_flag=""
  if [[ "$fresh" == "true" ]]; then
    clear_flag="-c"
  fi

  # nohup + disown keeps Metro alive after the launcher exits (macOS has no setsid).
  # Invoke expo-start directly — skip npm wrapper for a stable child PID.
  nohup env -u CI EXPO_NO_METRO_LAZY=1 \
    bash -c "cd \"${APP_ROOT}\" && exec node scripts/expo-start.mjs start --lan ${clear_flag}" \
    >> "$METRO_LOG" 2>&1 < /dev/null &

  disown 2>/dev/null || true

  # Wait for the real Expo CLI listener on :8081.
  local i=0 child=""
  while (( i < 60 )); do
    if child="$(find_metro_pid 2>/dev/null || true)"; then
      echo "$child" > "$PID_FILE"
      echo "$child"
      return 0
    fi
    sleep 0.25
    i=$((i + 1))
  done

  return 1
}

cmd_start() {
  local fresh="${1:-false}"
  ensure_project_ready
  ensure_runtime_dirs

  local udid=""
  udid="$(resolve_simulator_udid || true)"
  if [[ -z "$udid" ]]; then
    err "No iOS Simulator device found. Install Xcode runtimes or open Simulator once."
    exit 1
  fi

  # Fast path only for explicit `kairo start` — default `kairo` always passes fresh=true.
  if [[ "$fresh" != "true" ]] && metro_http_ok; then
    local pid=""
    pid="$(find_metro_pid 2>/dev/null || true)"
    ok "Metro already running${pid:+ (PID ${pid})}"
    boot_simulator "$udid"
    info "Opening Kairo on simulator..."
    open_app_on_simulator "$udid" || warn "Could not deep-link — press i in Metro or reload Expo Go"
    write_state "running" "ios" "${pid:-}" "healthy" "$udid"
    return 0
  fi

  if [[ "$fresh" != "true" ]] \
    && pid="$(find_metro_pid 2>/dev/null || true)" && [[ -n "$pid" ]]; then
    warn "Metro process found (PID ${pid}) but /status not ready — waiting..."
    if wait_for_metro 40; then
      ok "Metro healthy (PID ${pid})"
      boot_simulator "$udid"
      open_app_on_simulator "$udid" || true
      write_state "running" "ios" "$pid" "healthy" "$udid"
      return 0
    fi
    warn "Stale Metro process — restarting"
    cmd_stop
    sleep 0.35
  fi

  if [[ "$fresh" == "true" ]]; then
    info "Fresh start (Metro --clear + clean Expo Go launch)..."
  else
    info "Starting Kairo (Metro + iOS Simulator)..."
  fi
  boot_simulator "$udid" || warn "Simulator boot slow — continuing"

  if ! metro_pid="$(launch_metro_background "$fresh")"; then
    err "Metro failed to start. Check: kairo logs"
    tail -n 30 "$METRO_LOG" >&2 || true
    write_state "error" "ios" "" "down" "$udid"
    exit 1
  fi

  info "Waiting for Metro on port ${DEFAULT_PORT}..."
  if ! wait_for_metro 100; then
    err "Metro did not become healthy in time"
    err "Check: kairo logs"
    tail -n 40 "$METRO_LOG" >&2 || true
    write_state "error" "ios" "$metro_pid" "down" "$udid"
    exit 1
  fi

  # Give Metro a moment to accept bundle requests before deep-linking Expo Go.
  sleep 1

  if [[ "$fresh" == "true" ]]; then
    terminate_expo_on_simulator "$udid"
    sleep 0.5
  fi

  info "Opening Kairo on simulator..."
  open_app_on_simulator "$udid" || warn "Could not deep-link — open Expo Go manually or press i in Metro"

  ok "Kairo running"
  write_state "running" "ios" "$metro_pid" "healthy" "$udid"
  echo ""
  echo "═══════════════════════════════════════════════════════"
  echo "  Kairo dev"
  echo "═══════════════════════════════════════════════════════"
  echo "  Metro:      http://127.0.0.1:${DEFAULT_PORT} (healthy)"
  echo "  Simulator:  $(simulator_name "$udid" | sed 's/ (.*//')"
  echo "  Logs:       ${METRO_LOG}"
  echo "  Stop:       kairo stop"
  if [[ "$fresh" == "true" ]]; then
    echo "  Tip:        Cmd+R in simulator reloads JS after code changes"
  fi
  echo "═══════════════════════════════════════════════════════"
  echo ""
}

cmd_restart() {
  local udid=""
  udid="$(resolve_simulator_udid || true)"

  info "Full fresh restart..."
  cmd_stop
  if [[ -n "$udid" ]]; then
    terminate_expo_on_simulator "$udid"
  fi
  if [[ "${KAIRO_SKIP_CACHE_CLEAR:-}" != "1" ]]; then
    clear_dev_caches
  else
    warn "KAIRO_SKIP_CACHE_CLEAR=1 — skipping cache wipe"
  fi
  rotate_metro_log
  sleep 0.5
  # Boot simulator early so Expo Go is ready when Metro comes up.
  if [[ -n "$udid" ]]; then
    boot_simulator "$udid" || warn "Simulator boot slow — continuing"
  fi
  cmd_start true
  if [[ -n "$udid" ]]; then
    sleep 2
    info "Reloading Expo Go bundle..."
    reload_expo_on_simulator "$udid"
  fi
}

cmd_status() {
  ensure_runtime_dirs
  echo "Kairo — status"
  echo "──────────────────────────────────────"
  echo "Project:     ${APP_ROOT}"

  if pid="$(find_metro_pid 2>/dev/null || true)"; then
    echo "Metro PID:   ${pid}"
  else
    echo "Metro PID:   —"
  fi

  if metro_http_ok; then
    echo "Metro:       healthy (/status OK on :${DEFAULT_PORT})"
  else
    echo "Metro:       down"
  fi

  local udid=""
  udid="$(resolve_simulator_udid || true)"
  if [[ -n "$udid" ]]; then
    echo "Simulator:   $(simulator_name "$udid")"
    if xcrun simctl list devices booted 2>/dev/null | grep -q "$udid"; then
      echo "Sim state:   booted"
    else
      echo "Sim state:   shutdown"
    fi
  fi

  if [[ -f "$STATE_FILE" ]]; then
    echo "State file:  ${STATE_FILE}"
  fi
  echo "Logs:        ${LOG_DIR}/"
}

cmd_logs() {
  ensure_runtime_dirs
  local follow="${1:-false}"
  if [[ ! -f "$METRO_LOG" ]]; then
    warn "No logs yet. Run: kairo"
    return 0
  fi
  if [[ "$follow" == "true" || "$follow" == "-f" ]]; then
    tail -n 80 -f "$METRO_LOG"
  else
    tail -n 80 "$METRO_LOG"
  fi
}

cmd_validate() {
  info "Running quality gates (typecheck, lint, tests, circular deps, secrets)…"
  (unset NODE_ENV; cd "$APP_ROOT" && npm run validate:release) || {
    err "validate failed"
    exit 1
  }
  ok "All quality gates passed"
}

cmd_clean() {
  info "Deep dev cache cleanup (explicit — not a runtime perf fix)…"
  cmd_stop
  clear_dev_caches
  rotate_metro_log
  ok "Caches cleared. Run: kairo"
}

cmd_perf() {
  info "Starting Kairo with performance probes (EXPO_PUBLIC_KAIRO_PERF_PROBE=1)…"
  export EXPO_PUBLIC_KAIRO_PERF_PROBE=1
  cmd_restart
  echo ""
  echo "After exercising tab switches, run: npm run perf:report"
}

cmd_test() {
  info "Running unit tests…"
  (cd "$APP_ROOT" && npm test -- --runInBand) || exit 1
  ok "Tests passed"
}

cmd_ios() {
  info "Starting Expo iOS (development)…"
  ensure_project_ready
  (cd "$APP_ROOT" && npm run start:ios)
}

cmd_preview() {
  info "EAS preview build (internal distribution)…"
  (cd "$APP_ROOT" && npx eas-cli build --platform ios --profile preview --non-interactive) || exit 1
}

cmd_release() {
  info "Local release validation (no App Store submit)…"
  (cd "$APP_ROOT" && npm run validate:ios-release) || exit 1
  ok "Release validation passed"
}

check_disk_space() {
  local avail_kb
  avail_kb="$(df -k / | awk 'NR==2 {print $4}')"
  if [[ -n "$avail_kb" && "$avail_kb" -lt 2097152 ]]; then
    warn "Low disk space (< 2 GiB free on /). Builds may fail."
    warn "Largest dev caches: DerivedData, CoreSimulator, ~/.npm, ~/.expo"
  fi
}

usage() {
  cat <<'EOF'
Kairo — launch the Expo dev server and iOS Simulator

Usage:
  kairo              Full fresh restart (default): stop Metro, clear all bundler caches,
                     watchman reset, Metro --clear, terminate Expo Go, boot simulator,
                     relaunch + reload bundle
  kairo start        Lightweight start — reuse healthy Metro if already running
  kairo restart      Same as bare `kairo` (full fresh restart)
  kairo stop         Stop Metro and Kairo bundler workers
  kairo status       Show Metro / simulator status
  kairo logs         Tail Metro log (kairo logs -f to follow)
  kairo clean        Explicit deep cache cleanup (no Metro restart)
  kairo validate     Run typecheck + lint + tests (fast quality gate)
  kairo test         Run Jest test suite
  kairo perf         Fresh restart with EXPO_PUBLIC_KAIRO_PERF_PROBE=1
  kairo ios          expo run:ios (native dev client)
  kairo preview      EAS preview/internal iOS build
  kairo release      Local release validation (validate:ios-release, no submit)

Environment:
  KAIRO_METRO_PORT        Metro port (default: 8081)
  KAIRO_SKIP_CACHE_CLEAR  Set to 1 to skip cache wipe on fresh restart
  EXPO_PUBLIC_KAIRO_PERF_PROBE  Set to 1 for perf markers (also: kairo perf)
EOF
}

main() {
  local cmd="${1:-}"
  trap release_lock EXIT
  case "$cmd" in
    -h|--help|help) usage ;;
    stop)           cmd_stop ;;
    start)          acquire_lock; cmd_start false ;;
    restart)        acquire_lock; cmd_restart ;;
    status)         cmd_status ;;
    logs)           shift || true; cmd_logs "${1:-false}" ;;
    clean)          acquire_lock; cmd_clean ;;
    validate)       cmd_validate ;;
    test)           cmd_test ;;
    perf)           acquire_lock; cmd_perf ;;
    ios)            cmd_ios ;;
    preview)        cmd_preview ;;
    release)        cmd_release ;;
    "")             acquire_lock; cmd_restart ;;
    *)
      err "Unknown command: $cmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
