{
  "name": "kairo",
  "version": "0.6.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/expo-start.mjs",
    "start:clear": "node scripts/expo-start.mjs start --lan -c",
    "start:tunnel": "node scripts/expo-start.mjs start --tunnel",
    "start:ios": "node scripts/expo-start.mjs start --lan --ios",
    "start:ios:clear": "node scripts/expo-start.mjs start --lan --ios -c",
    "fix:dev-path": "node scripts/relocate-dev-root.mjs",
    "android": "node scripts/expo-start.mjs start --android",
    "ios": "node scripts/expo-start.mjs start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Los_Angeles jest",
    "test:soak": "KAIRO_SOAK_RUN=1 TZ=America/Los_Angeles node --expose-gc ./node_modules/jest/bin/jest.js --runTestsByPath src/qa/soak/soak.test.ts --runInBand --testTimeout=2147483647",
    "test:storage-stress": "TZ=America/Los_Angeles jest --runTestsByPath src/data/storage/moodStorage.test.ts src/data/storage/dayTodosStorage.test.ts src/data/storage/tasksStorage.test.ts src/data/storage/goalsStorage.test.ts src/data/persistence/persistence.test.ts src/data/persistence/sqlite/moodEntriesSqlite.test.ts src/data/persistence/sqlite/habitsGoalsSqlite.test.ts src/data/repositories/userDataExportRepository.test.ts src/qa/entriesScaleHarness.test.ts",
    "doctor": "npx expo-doctor",
    "export:ios-check": "npx expo export -p ios --output-dir .tmp-expo-export -c",
    "export:bundles-check": "npx expo export -p all --output-dir .tmp-expo-export -c",
    "validate": "npm run typecheck && npm run lint && npm test",
    "validate:ios-release": "npm run typecheck && npm run lint && npm test && npm run test:storage-stress && npm run doctor && npm run export:ios-check && npm audit --omit=dev --audit-level=moderate",
    "validate:release": "npm run validate && npm run test:storage-stress && npm run doctor && npm run export:bundles-check",
    "build:ios:production": "eas build --platform ios --profile production",
    "build:android:production": "eas build --platform android --profile production",
    "build:all:production": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "2.105.4",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.9",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.4",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@repositories/(.*)$": "<rootDir>/src/data/repositories/$1",
      "^@shared/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.14"
  }
}
