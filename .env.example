# Moodly environment (optional)
#
# Core app: local-first with optional Supabase cloud sync when configured below.
# Copy to `.env` for release-channel overrides (never commit `.env`).

# --- Supabase (cloud sync + auth) ---
# Create a project at https://supabase.com — see docs/SUPABASE.md
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Expo / Metro dev (optional) ---
# Dev defaults live in committed `.env.development` (EXPO_NO_METRO_LAZY=1).
# After moving/renaming the project folder, run: npm run start:clear
# If the repo path contains spaces, Expo Go will fail — run: npm run fix:dev-path
# EXPO_DEBUG=1          # Verbose Metro resolver logging
# MOODLY_ALLOW_SPACED_PATH=1  # Override spaced-path guard (Expo Go may still fail)
# EXPO_PUBLIC_MOODLY_PERF_PROBE=1  # Dev hitch RAF + perf logs (off by default for smooth Simulator)

# EAS build channel label (see app.config.ts)
# APP_VARIANT=production
# APP_VARIANT=development
# APP_VARIANT=preview

# Public legal URLs (HTTPS) for App Store / Play — host docs/PRIVACY.md and docs/TERMS.md on your domain
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/moodly/privacy
# EXPO_PUBLIC_TERMS_URL=https://example.com/moodly/terms
# EXPO_PUBLIC_SUPPORT_URL=https://example.com/moodly/support
